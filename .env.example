# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb+srv://gthinkgroup53_db_user:WSyaOp4AEfPer1cR@cluster0.6l7uj2u.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=gthink_erp_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Virtual Terminal code from Paystack Dashboard → Terminals (e.g. VT_xxxxx)
PAYSTACK_VIRTUAL_TERMINAL_CODE=
# Webhook URL to register in Paystack dashboard: https://your-api-domain/api/webhooks/paystack

# Google OAuth (for storefront customer Google Sign-In)
# Get from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Product deployment mode: full | pos | storefront | accounting
# full = entire ERP (default). Others expose a subset of API routes.
PRODUCT_MODE=full
